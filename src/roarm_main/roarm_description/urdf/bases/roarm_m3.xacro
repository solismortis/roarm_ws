<?xml version="1.0" ?>
<robot name="roarm_m3" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find roarm_description)/urdf/materials.xacro" />
<xacro:include filename="$(find roarm_description)/urdf/gazebo/roarm_m3.trans" />
<xacro:include filename="$(find roarm_description)/urdf/gazebo/roarm_m3.gazebo" />

<!-- Declared here: this file is also an entry for roarm_description/display.launch.py -->
<xacro:arg name="add_depth_camera" default="false"/>
<xacro:property name="add_depth_camera" value="$(arg add_depth_camera)"/>

<xacro:arg name="add_camera" default="false"/>
<xacro:property name="add_camera" value="$(arg add_camera)"/>

<xacro:arg name="GZ_VERSION" default="classic"/>
<xacro:property name="GZ_VERSION" value="$(arg GZ_VERSION)"/>

<xacro:if value="${add_depth_camera}">
<xacro:include filename="$(find roarm_description)/urdf/camera/depth_camera.xacro" />
<xacro:include filename="$(find roarm_description)/urdf/camera/depth_camera.gazebo.xacro" />
<xacro:oak use_gazebo="true">
  <parent link="link4" />
  <origin xyz="-0.066257 -0.0523 0" rpy="1.5708 0 -1.5708" />
  <!-- oak cam in hand -->
</xacro:oak>  
</xacro:if>

<xacro:if value="${add_camera}">
<xacro:include filename="$(find roarm_description)/urdf/camera/camera.xacro" />
<xacro:include filename="$(find roarm_description)/urdf/camera/camera.gazebo.xacro" />
<xacro:cam use_gazebo="true">
  <parent link="link4" />
  <origin xyz="-0.046 -0.072938 0" rpy="1.5708 0 -1.3963" />
  <!-- usb cam in hand -->
</xacro:cam>  
<!-- <xacro:cam use_gazebo="true">
  <parent link="base_link" />
  <origin xyz="0.06531 0 0.021953" rpy="0 0 0" />
  usb cam out hand
</xacro:cam>  -->
</xacro:if>

<link name="world"></link>

<link name="base_link">
  <inertial>
    <origin xyz="0.0032 0 0.0417" rpy="0 0 0" />
    <mass value="0.2562183" />
    <inertia ixx="0.00029211" ixy="0" ixz="0" iyy="0.00035719" iyz="0" izz="0.000349421" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link1">
  <inertial>
    <origin xyz="0 0 0.037" rpy="0 0 0" />
    <mass value="0.0729177" />
    <inertia ixx="4.68465E-05" ixy="0" ixz="0" iyy="3.32107E-05" iyz="0" izz="5.01023E-05" />
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link2">
  <inertial>
    <origin xyz="0.119 0.012247 -0.0001 " rpy="0 0 0"/>
    <mass value="0.0703216" />
    <inertia ixx="5.46501E-05" ixy="0" ixz="0" iyy="0.000423091" iyz="0" izz="0.000404557" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link3">
  <inertial>
    <origin xyz="-0.0015 -0.0765 0.00505" rpy="0 0 0"/>
    <mass value="0.021608"/>
    <inertia ixx="6.37699E-05" iyy="3.67026E-06" izz="6.28965E-05" ixy="0.0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link3.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link3.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link4">
  <inertial>
    <origin xyz="-0.0015 -0.022 -0.00075" rpy="0 0 0"/>
    <mass value="0.0099933"/>
    <inertia ixx="4.53979E-06" iyy="3.78103E-06" izz="5.60238E-06" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link4.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/link4.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link5_1">
  <inertial>
    <origin xyz="-0.0001403 0.0161404 0.0436813" rpy="0 0 0"/>
    <!-- origin xyz="0 0 0" rpy="0 0 0"/ -->
    <mass value="0.5561721109318601"/>
    <inertia ixx="0.000485" iyy="0.000623" izz="0.000829" ixy="-8.848657096881746e-07" iyz="3.5202789913301415e-05" ixz="-2.3790504659423504e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/visual/link5_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/collision/link5_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="clamp_1">
  <inertial>
    <origin xyz="-0.0022451450839581995 0.014393356036471921 0.012641725210982086" rpy="0 0 0"/>
    <mass value="0.15381179772652928"/>
    <inertia ixx="6.028924399607782e-05" iyy="7.038714258563392e-05" izz="4.17315343246402e-05" ixy="-3.4254600321855882e-06" iyz="-2.118105479936555e-06" ixz="-4.099503004252556e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/visual/clamp_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/collision/clamp_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="clamp_2">
  <inertial>
    <origin xyz="0.0022451450839581995 0.014393356036471921 0.012641725210982086" rpy="0 0 0"/>
    <mass value="0.15381179772652928"/>
    <inertia ixx="6.028672432876903e-05" iyy="7.038715437435056e-05" izz="4.1734047474310416e-05" ixy="-3.426101766664184e-06" iyz="2.1169750169208525e-06" ixz="4.105213994636254e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/visual/clamp_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m3/collision/clamp_2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="hand_tcp"></link>

<joint name="world_to_base_link" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>
  
<joint name="base_link_to_link1" type="revolute">
  <origin xyz="0.0100000008759151 0.0 0.0716" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit
    lower="-3.1416"
    upper="3.1416"
    effort="20" 
    velocity="3.14" />
</joint>

<joint name="link1_to_link2" type="revolute">
  <origin xyz="0.0 0.0 0.051959" rpy="-1.5708 -1.5708 0"/>
  <parent link="link1"/>
  <child link="link2"/>
  <axis xyz="-0.0 0 1.0"/>
  <limit
    lower="-1.5708"
    upper="1.5708"
    effort="20" 
    velocity="3.14" />
</joint>

<joint name="link2_to_link3" type="revolute">
  <origin xyz="0.236815 0.030002 0" rpy="0 0 1.5708"/>
  <parent link="link2"/>
  <child link="link3"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit
    lower="0"
    upper="2.95"
    effort="20" 
    velocity="3.14" /> 
</joint>

<joint name="link3_to_link4" type="revolute">
  <origin xyz="0.0 -0.144586 0" rpy="0 0 0"/>
  <parent link="link3"/>
  <child link="link4"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit
    lower="-1.5708"
    upper="1.5708"
    effort="20" 
    velocity="3.14" />
</joint>

<joint name="link4_to_link5" type="revolute">
  <!-- origin xyz="0 0 0" rpy="1.5708 1.5708 0"/ -->
  <origin xyz="0.015147 -0.05 0" rpy="1.5708 1.5708 0"/>
  <parent link="link4"/>
  <child link="link5_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit
    lower="-3.1416"
    upper="3.1416"
    effort="20" 
    velocity="3.14" />
</joint>

<!-- Gripper: right clamp (primary) — STS3215 servo -->
<joint name="right_clamp" type="prismatic">
  <origin xyz="0 -0.0159466 0.066909" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="clamp_1"/>
  <axis xyz="1 0 0"/>
  <limit lower="0.0" upper="0.037" effort="1.5" velocity="0.05"/>
  <dynamics damping="0.5" friction="0.1"/>
</joint>

<!-- Gripper: left clamp (mimic of right_clamp, inverted) -->
<joint name="left_clamp" type="prismatic">
  <origin xyz="0 -0.0159466 0.066909" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="clamp_2"/>
  <axis xyz="1 0 0"/>
  <limit lower="-0.038" upper="0.0" effort="1.5" velocity="0.05"/>
  <dynamics damping="0.5" friction="0.1"/>
  <mimic joint="right_clamp" multiplier="-1" offset="0"/>
</joint>

<joint name="link5_to_hand_tcp" type="fixed">
  <origin xyz="0 0 0.115428" rpy="1.5708 -1.5708 0"/>
  <parent link="link5_1"/>
  <child link="hand_tcp"/>
  <axis xyz="0 0 0"/>
</joint>

</robot>

